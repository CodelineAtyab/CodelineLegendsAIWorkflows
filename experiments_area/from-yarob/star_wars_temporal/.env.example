# Copy this file to .env and change the values:  cp .env.example .env
# docker compose reads .env automatically from this folder.
# .env is git-ignored, so your real password never gets committed.

# Postgres credentials. Temporal uses the same values to log in to Postgres.
# WARNING: Postgres saves the password only the FIRST time its volume is
# created. If you change it later, Temporal fails with "password
# authentication failed" and the worker gets "connection refused" on 7233.
# Fix: put the old password back, or run "docker compose down -v"
# (this deletes all workflow history) and then "docker compose up -d".
POSTGRES_USER=temporal
POSTGRES_PASSWORD=change-me-locally

# Optional: where the activities send their HTTP requests.
# Set it to a wrong URL for the "retry test" (see README).
SWAPI_BASE_URL=https://swapi.dev/api
