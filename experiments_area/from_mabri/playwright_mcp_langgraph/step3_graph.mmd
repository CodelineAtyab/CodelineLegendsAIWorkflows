---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	open_page(open_page)
	read_snapshot(read_snapshot)
	fill_form(fill_form)
	submit(submit)
	verify(verify)
	save_evidence(save_evidence)
	__end__([<p>__end__</p>]):::last
	__start__ --> open_page;
	fill_form --> submit;
	open_page --> read_snapshot;
	read_snapshot -.-> fill_form;
	read_snapshot -.-> save_evidence;
	submit --> verify;
	verify --> save_evidence;
	save_evidence --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
