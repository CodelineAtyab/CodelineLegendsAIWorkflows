# =============================================================================
# Qdrant RAG workflow - configuration template
#
#   cp sample.env .env      # then paste your OpenAI key
#
# `.env` is loaded automatically by qdrant_rag.config and is never committed.
# =============================================================================

# --- OpenAI ----------------------------------------------------------------
# Required. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=put-your-key-here

# Chat model used by the query workflow.
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Embedding model used by both workflows. Changing it requires
# `uv run python main.py ingest --recreate`, because the vector size changes.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Qdrant (docker/docker-compose.yml) ------------------------------------
# Host address - inside Docker the service is reachable as http://qdrant:6333.
QDRANT_URL=http://localhost:6333
# Only needed for Qdrant Cloud or a secured instance. Leave empty locally.
QDRANT_API_KEY=
QDRANT_COLLECTION=pdf_knowledge

# --- Ingest ----------------------------------------------------------------
# Drop your PDFs here. Ingested files are renamed with a leading underscore
# (report.pdf -> _report.pdf) so the next run skips them.
PDF_DIR=data/pdfs
CHUNK_SIZE_TOKENS=1000
CHUNK_OVERLAP_TOKENS=200

# --- Retrieval -------------------------------------------------------------
# How many chunks are sent to the chat model per question.
RETRIEVAL_TOP_K=4
# Cosine similarity cut-off; results below this are treated as "not found".
RETRIEVAL_SCORE_THRESHOLD=0.2
