# =============================================================================
# Temporal + PostgreSQL - configuration template
#
#   cp sample.env .env    # then change POSTGRES_PASSWORD
#
# `.env` is read automatically by `docker compose`. Do not commit it.
# =============================================================================

# Prefix for container/network/volume names.
COMPOSE_PROJECT_NAME=temporal

# --- Image versions ----------------------------------------------------------
# Upgrade Temporal one minor version at a time. TEMPORAL_VERSION and
# TEMPORAL_ADMINTOOLS_VERSION must always match.
TEMPORAL_VERSION=1.32.2
TEMPORAL_ADMINTOOLS_VERSION=1.32.2
TEMPORAL_UI_VERSION=2.56.4
POSTGRES_VERSION=17-alpine

# --- PostgreSQL --------------------------------------------------------------
# CHANGE_ME: use a long random value, e.g. `openssl rand -base64 24`.
# Keep it URL-safe (letters, digits, - and _).
POSTGRES_USER=temporal
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# Databases created by the schema-setup job.
POSTGRES_DB=temporal
POSTGRES_VISIBILITY_DB=temporal_visibility

# Light tuning; bump shared_buffers to ~25% of host RAM for real workloads.
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=512MB

# --- Temporal server ---------------------------------------------------------
# History shard count. Do NOT change after the database is initialized.
TEMPORAL_NUM_HISTORY_SHARDS=512
TEMPORAL_LOG_LEVEL=info

# --- Host ports (bound to 127.0.0.1) -----------------------------------------
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8080
TEMPORAL_UI_CORS_ORIGINS=http://localhost:8080

# --- Namespaces --------------------------------------------------------------
TEMPORAL_DEFAULT_NAMESPACE=default
# Retention for newly created namespaces (24h, 7d, 30d, ...).
TEMPORAL_NAMESPACE_RETENTION=7d
# Comma-separated extra namespaces, e.g. staging,sandbox
TEMPORAL_EXTRA_NAMESPACES=

# --- Misc --------------------------------------------------------------------
TZ=UTC
